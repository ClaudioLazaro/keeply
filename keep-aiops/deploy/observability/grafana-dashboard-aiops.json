{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Investigations",
      "description": "Investigations currently running (gathering / writeback in flight).",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 } ] }, "unit": "none" },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "refId": "A", "expr": "keep_aiops_investigations_active", "legendFormat": "active", "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Investigations Started / Completed / Failed (rate)",
      "description": "Per-second rate of investigation lifecycle transitions by outcome.",
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*failed.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }, { "matcher": { "id": "byRegexp", "options": ".*completed.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (mode) (rate(keep_aiops_investigations_started_total[$__rate_interval]))", "legendFormat": "started ({{mode}})", "datasource": { "type": "prometheus", "uid": "${datasource}" } },
        { "refId": "B", "expr": "sum by (mode) (rate(keep_aiops_investigations_completed_total[$__rate_interval]))", "legendFormat": "completed ({{mode}})", "datasource": { "type": "prometheus", "uid": "${datasource}" } },
        { "refId": "C", "expr": "sum by (mode) (rate(keep_aiops_investigations_failed_total[$__rate_interval]))", "legendFormat": "failed ({{mode}})", "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failure Ratio (15m)",
      "description": "failed / started over the last 15m. Alert fires above 0.2.",
      "gridPos": { "h": 6, "w": 4, "x": 14, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.2 } ] }, "unit": "percentunit", "max": 1, "min": 0 },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(keep_aiops_investigations_failed_total[15m])) / sum(rate(keep_aiops_investigations_started_total[15m]))", "legendFormat": "failure ratio", "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Investigation Duration p50 / p95",
      "description": "Histogram quantiles of investigation_duration_seconds. Alert fires when p95 > 900s for 30m.",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*p95.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(keep_aiops_investigation_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p50", "datasource": { "type": "prometheus", "uid": "${datasource}" } },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(keep_aiops_investigation_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p95", "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "MCP Tool Call Outcomes (rate)",
      "description": "Gateway tool invocations from the orchestrator by tool and outcome (success / error).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*error.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (tool, outcome) (rate(keep_aiops_mcp_tool_calls_total[$__rate_interval]))", "legendFormat": "{{tool}} / {{outcome}}", "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Evidence Gaps",
      "description": "Evidence items that could not be gathered (policy deny or tool error). Gaps degrade RCA drafts — sustained non-zero rate warrants investigation.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 60, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (tool) (increase(keep_aiops_evidence_gaps_total[$__rate_interval]))", "legendFormat": "{{tool}}", "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP Request Rate / Errors",
      "description": "aiops-api HTTP traffic (instrumented endpoints, /metrics excluded).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*5xx.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (handler) (rate(keep_aiops_http_requests_total[$__rate_interval]))", "legendFormat": "{{handler}}", "datasource": { "type": "prometheus", "uid": "${datasource}" } },
        { "refId": "B", "expr": "sum(rate(keep_aiops_http_requests_total{status=~\"5..\"}[$__rate_interval]))", "legendFormat": "5xx", "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP Latency p95",
      "description": "p95 handler latency.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(keep_aiops_http_request_duration_seconds_bucket[$__rate_interval])) by (le, handler))", "legendFormat": "{{handler}}", "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["aiops", "keep"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "options": [],
        "refresh": 1,
        "regex": "",
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Keep AIOps — AI Plane",
  "uid": "keep-aiops-ai-plane",
  "version": 1,
  "weekStart": ""
}
